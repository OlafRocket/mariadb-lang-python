#
# inhost.sql.query_array: KILL of the calling statement, concurrent use
#
CREATE TABLE ready (n INT);
# --- KILL QUERY reaches the internal statement at the next row ---
connect  con1,localhost,root,,test;
SELECT py_exec('import inhost\ninhost.sql.execute("INSERT INTO test.ready VALUES (1)")\nresult = len(inhost.sql.query_array("SELECT seq, SLEEP(0.001) AS z FROM test.seq_1_to_200000")["seq"])', 'INT') AS n;
connection default;
connection con1;
ERROR HY000: py_exec: Error: Query execution was interrupted
SELECT 'con1 usable after KILL' AS state;
state
con1 usable after KILL
SELECT py_exec('
import inhost
result = int(inhost.sql.query_array("SELECT seq FROM test.seq_1_to_10")["seq"].sum())
', 'INT') AS works_again;
works_again
55
# --- a body may catch the interruption; the extraction still stops early ---
SELECT py_exec('import inhost\ninhost.sql.execute("INSERT INTO test.ready VALUES (2)")\ntry:\n    inhost.sql.query_array("SELECT seq, SLEEP(0.001) AS z FROM test.seq_1_to_200000")\n    result = "finished"\nexcept inhost.sql.Error as e:\n    result = "caught"', 'VARCHAR') AS r;
connection default;
connection con1;
r
caught
# --- KILL QUERY also reaches query() ---
SELECT py_exec('import inhost\ninhost.sql.execute("INSERT INTO test.ready VALUES (3)")\nresult = len(inhost.sql.query("SELECT seq, SLEEP(0.001) AS z FROM test.seq_1_to_200000"))', 'INT') AS n;
connection default;
connection con1;
ERROR HY000: py_exec: Error: Query execution was interrupted
# --- four connections extract at the same time ---
connect  con2,localhost,root,,test;
connect  con3,localhost,root,,test;
connect  con4,localhost,root,,test;
connection con1;
SELECT py_exec('import inhost\nc = inhost.sql.query_array("SELECT seq, seq * 0.5e0 AS h FROM test.seq_1_to_400000")\nresult = str(len(c["seq"])) + " " + str(c["seq"].sum()) + " " + str(c["h"].sum())', 'VARCHAR') AS r1;
connection con2;
SELECT py_exec('import inhost\nc = inhost.sql.query_array("SELECT seq, seq * 0.5e0 AS h FROM test.seq_1_to_300000")\nresult = str(len(c["seq"])) + " " + str(c["seq"].sum()) + " " + str(c["h"].sum())', 'VARCHAR') AS r2;
connection con3;
SELECT py_exec('import inhost\nc = inhost.sql.query_array("SELECT seq, CONCAT(\'s\', seq) AS s FROM test.seq_1_to_200000")\nresult = str(len(c["seq"])) + " " + str(c["seq"].sum()) + " " + c["s"][-1]', 'VARCHAR') AS r3;
connection con4;
SELECT py_exec('import inhost\nresult = str(len(inhost.sql.query("SELECT seq FROM test.seq_1_to_100000")))', 'VARCHAR') AS r4_text_path;
connection con1;
r1
400000 80000200000 40000100000.0
connection con2;
r2
300000 45000150000 22500075000.0
connection con3;
r3
200000 20000100000 s200000
connection con4;
r4_text_path
100000
connection default;
DROP TABLE ready;
disconnect con1;
disconnect con2;
disconnect con3;
disconnect con4;
