--source include/have_sequence.inc

--echo #
--echo # Python aggregates (Phase 2): catalog kind 'aggregate', a class with
--echo # step()/finalize() that py_agg feeds one chunk of rows at a time
--echo #

CREATE TABLE t1 (grp INT, id INT, d DOUBLE, name VARCHAR(20), v VECTOR(2));
INSERT INTO t1 VALUES
  (1, 1, 1.5,  'alice', VEC_FromText('[1,2]')),
  (1, 2, 2.5,  'bob',   VEC_FromText('[3,4]')),
  (2, 3, 4.0,  'carol', VEC_FromText('[5,6]')),
  (2, 4, NULL, NULL,    VEC_FromText('[7,8]')),
  (2, 5, 6.0,  'carol', VEC_FromText('[9,10]'));

--echo # --- create; the catalog records the kind ---
SELECT py_create_aggregate('a_sum', 'INT', 'x', '
class Aggregate:
    def __init__(self):
        self.total = 0
    def step(self, x):
        self.total += int(x.sum())
    def finalize(self):
        return self.total
');
SELECT py_create_function('f_sum', 'INT', 'x', 'result = int(x.sum())');
SELECT name, kind, return_type, param_names FROM mysql.lang_python_func ORDER BY name;

--echo # --- one instance per group ---
SELECT grp, py_agg('a_sum', id) AS s FROM t1 GROUP BY grp ORDER BY grp;
SELECT py_agg('a_sum', id) AS whole_table FROM t1;

--echo # --- step() sees arrays of at most lang_python_agg_chunk_rows rows ---
SELECT @@lang_python_agg_chunk_rows;
SELECT py_create_aggregate('a_trace', 'VARCHAR', 'x,y', '
class Aggregate:
    def __init__(self):
        self.calls = []
    def step(self, x, y):
        self.calls.append(type(x).__name__ + ":" + str(x.dtype) + str(x.tolist()) + "/" + str(y.dtype) + str(y.tolist()))
    def finalize(self):
        return " | ".join(self.calls)
');
SELECT py_agg('a_trace', id, d) AS default_chunk FROM t1;
SET SESSION lang_python_agg_chunk_rows = 2;
SELECT py_agg('a_trace', id, d) AS chunk_2 FROM t1;
SELECT grp, py_agg('a_trace', id, d) AS chunk_2_grouped FROM t1 GROUP BY grp ORDER BY grp;
SET SESSION lang_python_agg_chunk_rows = 1;
SELECT py_agg('a_trace', id, d) AS chunk_1 FROM t1;
SET SESSION lang_python_agg_chunk_rows = DEFAULT;

--echo # --- the result does not depend on the chunk size ---
SELECT py_create_aggregate('a_stats', 'VARCHAR', 'x', '
import numpy
class Aggregate:
    def __init__(self):
        self.n = 0
        self.total = 0.0
        self.lo = None
        self.hi = None
        self.steps = 0
    def step(self, x):
        self.steps += 1
        self.n += len(x)
        self.total += float(x.sum())
        self.lo = float(x.min()) if self.lo is None else min(self.lo, float(x.min()))
        self.hi = float(x.max()) if self.hi is None else max(self.hi, float(x.max()))
    def finalize(self):
        return "n=%d sum=%.1f min=%.1f max=%.1f" % (self.n, self.total, self.lo, self.hi)
');
SELECT py_agg('a_stats', seq * 0.5e0) AS chunk_default FROM seq_1_to_100000;
SET SESSION lang_python_agg_chunk_rows = 7;
SELECT py_agg('a_stats', seq * 0.5e0) AS chunk_7 FROM seq_1_to_100000;
SET SESSION lang_python_agg_chunk_rows = 1000;
SELECT seq MOD 3 AS g, py_agg('a_stats', seq * 0.5e0) AS chunk_1000,
       COUNT(*) AS n, SUM(seq * 0.5e0) AS total
FROM seq_1_to_100000 GROUP BY seq MOD 3 ORDER BY g;
SET SESSION lang_python_agg_chunk_rows = DEFAULT;

--echo # --- a group larger than lang_python_agg_max_mem: only an aggregate can do it ---
SET SESSION lang_python_agg_max_mem = 65536;
SET SESSION lang_python_agg_chunk_rows = 4096;
--error ER_UNKNOWN_ERROR
SELECT py_agg('f_sum', seq) FROM seq_1_to_1000000;
SELECT py_agg('a_sum', seq) AS s, 1000000 * 1000001 DIV 2 AS expected FROM seq_1_to_1000000;
--echo # a chunk that itself exceeds the limit still fails
SET SESSION lang_python_agg_chunk_rows = 1000000;
--error ER_UNKNOWN_ERROR
SELECT py_agg('a_sum', seq) FROM seq_1_to_1000000;
SET SESSION lang_python_agg_max_mem = DEFAULT;
SET SESSION lang_python_agg_chunk_rows = DEFAULT;

--echo # --- args[] mode: step(self, *cols) ---
SELECT py_create_aggregate('a_shapes', 'VARCHAR', NULL, '
class Aggregate:
    def __init__(self):
        self.out = []
    def step(self, *cols):
        self.out.append(";".join(str(c.dtype) + str(c.shape) for c in cols))
    def finalize(self):
        return " | ".join(self.out)
');
SELECT py_agg('a_shapes', id, d, name, v) AS a FROM t1;

--echo # --- return types, NULL results, empty input ---
SELECT py_create_aggregate('a_mean', 'DOUBLE', 'x', '
import numpy
class Aggregate:
    def __init__(self):
        self.n = 0
        self.total = 0.0
    def step(self, x):
        ok = x[~numpy.isnan(x)]
        self.n += len(ok)
        self.total += float(ok.sum())
    def finalize(self):
        return self.total / self.n if self.n else None
');
SELECT grp, py_agg('a_mean', d) AS m FROM t1 GROUP BY grp ORDER BY grp;
SELECT py_agg('a_mean', d) AS all_null FROM t1 WHERE d IS NULL;
SELECT py_agg('a_mean', d) AS no_rows FROM t1 WHERE id < 0;
CREATE TABLE t2 AS SELECT grp, py_agg('a_mean', d) AS m, py_agg('a_trace', id, d) AS t FROM t1 GROUP BY grp;
SHOW CREATE TABLE t2;
DROP TABLE t2;

--echo # --- DISTINCT, FILTER, HAVING, several aggregates per statement ---
SELECT py_agg('a_sum', grp) AS all_rows, py_agg(DISTINCT 'a_sum', grp) AS uniq,
       py_agg('a_sum', id) FILTER (WHERE id > 2) AS filtered,
       py_agg('f_sum', id) AS whole_group_function
FROM t1;
SELECT grp, py_agg('a_sum', id) AS s FROM t1 GROUP BY grp HAVING py_agg('a_sum', id) > 3;

--echo # --- window frames: recomputed per row; running frames call finalize() repeatedly ---
SET SESSION lang_python_agg_chunk_rows = 2;
SELECT id, py_agg('a_sum', id) OVER (ORDER BY id) AS running,
           py_agg('a_sum', id) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS sliding,
           py_agg('a_sum', id) OVER (PARTITION BY grp) AS per_partition
FROM t1 ORDER BY id;
SET SESSION lang_python_agg_chunk_rows = DEFAULT;

--echo # --- the body runs once per statement, the class is instantiated per group ---
SELECT py_create_aggregate('a_count_inits', 'VARCHAR', 'x', '
body_runs = globals().get("body_runs", 0) + 1
instances = [0]
class Aggregate:
    def __init__(self):
        instances[0] += 1
        self.id = instances[0]
    def step(self, x):
        pass
    def finalize(self):
        return "body_runs=%d instance=%d" % (body_runs, self.id)
');
SELECT grp, py_agg('a_count_inits', id) AS a FROM t1 GROUP BY grp ORDER BY grp;

--echo # --- prepared statement across py_replace_aggregate ---
PREPARE st FROM "SELECT grp, py_agg('a_sum', id) AS s FROM t1 GROUP BY grp ORDER BY grp";
EXECUTE st;
SELECT py_replace_aggregate('a_sum', 'INT', 'x', '
class Aggregate:
    def __init__(self):
        self.total = 0
    def step(self, x):
        self.total += int(x.sum()) * 100
    def finalize(self):
        return self.total
');
EXECUTE st;
DEALLOCATE PREPARE st;

--echo # --- kinds share one namespace ---
--error ER_UNKNOWN_ERROR
SELECT py_create_aggregate('f_sum', 'INT', 'x', 'class Aggregate: pass');
--error ER_UNKNOWN_ERROR
SELECT py_create_function('a_sum', 'INT', 'x', 'result = 1');
--error ER_UNKNOWN_ERROR
SELECT py_call('a_sum', 1);
--echo # replace may change the kind, in both directions
SELECT py_replace_function('a_shapes', 'INT', 'x', 'result = len(x)');
SELECT py_agg('a_shapes', id) AS now_a_function FROM t1;
SELECT py_call('a_shapes', 'abc') AS callable_too;
SELECT py_replace_aggregate('a_shapes', 'INT', 'x', '
class Aggregate:
    def __init__(self):
        self.n = 0
    def step(self, x):
        self.n += len(x)
    def finalize(self):
        return self.n
');
SELECT py_agg('a_shapes', id) AS an_aggregate_again FROM t1;
SELECT name, kind FROM mysql.lang_python_func WHERE name IN ('a_shapes', 'a_sum', 'f_sum') ORDER BY name;

--echo # --- errors at create and prepare time ---
--error ER_UNKNOWN_ERROR
SELECT py_create_aggregate('a_bad', 'INT', 'x', 'class Aggregate
    pass');
--error ER_WRONG_VALUE_FOR_TYPE
SELECT py_create_aggregate('a_bad', 'NOPE', 'x', 'class Aggregate: pass');
--error ER_UNKNOWN_ERROR
SELECT py_agg('a_sum', id, d) FROM t1;

--echo # --- errors at run time: strict aborts ---
SELECT py_create_aggregate('a_noclass', 'INT', 'x', 'x = 1');
--error ER_UNKNOWN_ERROR
SELECT py_agg('a_noclass', id) FROM t1;
SELECT py_create_aggregate('a_nostep', 'INT', 'x', '
class Aggregate:
    def finalize(self):
        return 1
');
--error ER_UNKNOWN_ERROR
SELECT py_agg('a_nostep', id) FROM t1;
SELECT py_create_aggregate('a_boom_body', 'INT', 'x', 'raise RuntimeError("body")');
--error ER_UNKNOWN_ERROR
SELECT py_agg('a_boom_body', id) FROM t1;
SELECT py_create_aggregate('a_boom', 'INT', 'x,where', '
class Aggregate:
    def __init__(self):
        self.n = 0
        self.where = None
    def step(self, x, where):
        self.where = where[0]
        if self.where == "init":
            raise RuntimeError("never reached")
        if self.where == "step":
            raise RuntimeError("in step")
        self.n += len(x)
    def finalize(self):
        if self.where == "finalize":
            raise RuntimeError("in finalize")
        return self.n
');
SELECT py_agg('a_boom', id, 'ok') AS fine FROM t1;
--error ER_UNKNOWN_ERROR
SELECT py_agg('a_boom', id, 'step') FROM t1;
--error ER_UNKNOWN_ERROR
SELECT py_agg('a_boom', id, 'finalize') FROM t1;
--echo # NULL in an integer argument
--error ER_UNKNOWN_ERROR
SELECT py_agg('a_sum', IF(id = 2, NULL, id)) FROM t1;

--echo # --- errors at run time: lax gives NULL for the failing group only ---
SELECT py_create_aggregate('a_boom_lax', 'INT', 'x', '
class Aggregate:
    def __init__(self):
        self.n = 0
    def step(self, x):
        if (x == 4).any():
            raise RuntimeError("row 4")
        self.n += len(x)
    def finalize(self):
        return self.n
', 0);
SET SESSION lang_python_agg_chunk_rows = 1;
SELECT grp, py_agg('a_boom_lax', id) AS n FROM t1 GROUP BY grp ORDER BY grp;
SET SESSION lang_python_agg_chunk_rows = DEFAULT;

--echo # --- drop: py_drop_function drops either kind ---
SELECT py_drop_function('a_sum');
--error ER_UNKNOWN_ERROR
SELECT py_agg('a_sum', id) FROM t1;
SELECT py_drop_function('f_sum');
SELECT py_drop_function('a_trace');
SELECT py_drop_function('a_stats');
SELECT py_drop_function('a_shapes');
SELECT py_drop_function('a_mean');
SELECT py_drop_function('a_count_inits');
SELECT py_drop_function('a_noclass');
SELECT py_drop_function('a_nostep');
SELECT py_drop_function('a_boom_body');
SELECT py_drop_function('a_boom');
SELECT py_drop_function('a_boom_lax');
SELECT COUNT(*) FROM mysql.lang_python_func;
DROP TABLE t1;

--echo # --- an aggregate survives a restart as an aggregate ---
SELECT py_create_aggregate('new_agg', 'INT', 'x', '
class Aggregate:
    def __init__(self):
        self.n = 0
    def step(self, x):
        self.n += len(x)
    def finalize(self):
        return self.n
');
SELECT py_agg('new_agg', seq) AS n FROM seq_1_to_10;
--let $restart_parameters=
--source include/restart_mysqld.inc
SELECT py_agg('new_agg', seq) AS n_after_restart FROM seq_1_to_10;
SELECT py_drop_function('new_agg');

# The catalog table is auto-created on first use; drop it again so MTR's
# check-testcase sees identical before/after states of the mysql schema.
DROP TABLE mysql.lang_python_func;
