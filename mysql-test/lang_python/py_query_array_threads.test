--source include/have_sequence.inc

--echo #
--echo # inhost.sql.query_array: concurrent use
--echo #

connect (con1,localhost,root,,test);

--echo # --- four connections extract at the same time ---
connect (con2,localhost,root,,test);
connect (con3,localhost,root,,test);
connect (con4,localhost,root,,test);

connection con1;
--send SELECT py_exec('import inhost\nc = inhost.sql.query_array("SELECT seq, seq * 0.5e0 AS h FROM test.seq_1_to_400000")\nresult = str(len(c["seq"])) + " " + str(c["seq"].sum()) + " " + str(c["h"].sum())', 'VARCHAR') AS r1
connection con2;
--send SELECT py_exec('import inhost\nc = inhost.sql.query_array("SELECT seq, seq * 0.5e0 AS h FROM test.seq_1_to_300000")\nresult = str(len(c["seq"])) + " " + str(c["seq"].sum()) + " " + str(c["h"].sum())', 'VARCHAR') AS r2
connection con3;
--send SELECT py_exec('import inhost\nc = inhost.sql.query_array("SELECT seq, CONCAT(\'s\', seq) AS s FROM test.seq_1_to_200000")\nresult = str(len(c["seq"])) + " " + str(c["seq"].sum()) + " " + c["s"][-1]', 'VARCHAR') AS r3
connection con4;
--send SELECT py_exec('import inhost\nresult = str(len(inhost.sql.query("SELECT seq FROM test.seq_1_to_100000")))', 'VARCHAR') AS r4_text_path

connection con1;
--reap
connection con2;
--reap
connection con3;
--reap
connection con4;
--reap

connection default;
disconnect con1;
disconnect con2;
disconnect con3;
disconnect con4;
