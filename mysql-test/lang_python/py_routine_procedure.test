--echo #
--echo # lang_python: stored procedures in the language PYTHON
--echo #

--echo # An OUT or INOUT parameter is assigned by its name. The caller gets
--echo # what the name holds when the body ends

CREATE PROCEDURE p1(a INT, b INT, OUT r INT) LANGUAGE PYTHON AS $$ r = a * b $$;
SET @r = -1;
CALL p1(6, 7, @r);
SELECT @r;

CREATE PROCEDURE p2(IN s VARCHAR(20), INOUT n INT, OUT t VARCHAR(50), OUT d DOUBLE)
  LANGUAGE PYTHON AS $$
    n = n + len(s)
    t = s + ':' + str(n)
    d = n / 4
$$;
SET @n = 10;
CALL p2('abc', @n, @t, @d);
SELECT @n, @t, @d;
CALL p2('abcdef', @n, @t, @d);
SELECT @n, @t, @d;

--echo # An OUT parameter starts as None, whatever the caller passes. One
--echo # that is not assigned gives NULL
CREATE PROCEDURE p3(OUT a VARCHAR(20), OUT b INT) LANGUAGE PYTHON AS
$$ a = str(a) + '/' + str(b) $$;
SET @a = 'before', @b = 5;
CALL p3(@a, @b);
SELECT @a, @b;

--echo # The parameters are copied out after a return in the body
CREATE PROCEDURE p4(n INT, OUT sign VARCHAR(10)) LANGUAGE PYTHON AS $$
    if n < 0:
        sign = 'negative'
        return
    if n == 0:
        sign = 'zero'
        return None
    sign = 'positive'
$$;
CALL p4(-5, @s1);
CALL p4(0, @s2);
CALL p4(5, @s3);
SELECT @s1, @s2, @s3;

--echo # Without parameters, and with IN parameters only
CREATE PROCEDURE p5() LANGUAGE PYTHON AS $$ x = 1 $$;
CALL p5();
CALL p5;
CREATE PROCEDURE p6(a INT) LANGUAGE PYTHON AS $$ a = a + 1 $$;
CALL p6(1);

--echo #
--echo # Types of OUT and INOUT parameters
--echo #

CREATE PROCEDURE p7(INOUT big BIGINT UNSIGNED, INOUT dec1 DECIMAL(10,2),
                    INOUT bin VARBINARY(10), INOUT day DATE,
                    INOUT v VECTOR(2), OUT flag BOOLEAN)
  LANGUAGE PYTHON AS $$
    big = big + 1
    dec1 = dec1 * 2
    bin = bin[::-1]
    day = day.replace('-01', '-02')
    v = v + 1
    flag = True
$$;
SET @big = 18446744073709551614, @dec = 1.25, @bin = x'0102FF',
    @day = '2026-03-01', @v = VEC_FromText('[1,2]');
CALL p7(@big, @dec, @bin, @day, @v, @flag);
SELECT @big, @dec, HEX(@bin), @day, VEC_ToText(@v), @flag;

--echo # A value that does not fit the parameter: an error in strict mode
CREATE PROCEDURE p8(OUT n TINYINT, what INT) LANGUAGE PYTHON AS $$
    n = 'abc' if what == 0 else 1000
$$;
--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
CALL p8(@n, 0);
--error ER_WARN_DATA_OUT_OF_RANGE
CALL p8(@n, 1);

--echo #
--echo # Errors
--echo #

--echo # return with a value is refused at CREATE
--error ER_PARSE_ERROR
CREATE PROCEDURE e1(OUT r INT) LANGUAGE PYTHON AS $$
    r = 1
    return r
$$;
--echo # Not in a nested function
CREATE PROCEDURE p9(OUT r INT) LANGUAGE PYTHON AS $$
    def inner():
        return 41
    r = inner() + 1
$$;
CALL p9(@r);
SELECT @r;

--echo # After an exception the caller keeps its values
CREATE PROCEDURE p10(INOUT r INT) LANGUAGE PYTHON AS $$
    r = r + 1
    raise ValueError('not this time')
$$;
SET @r = 5;
--error ER_UNKNOWN_ERROR
CALL p10(@r);
SELECT @r;

--echo # An OUT parameter that the body has deleted
CREATE PROCEDURE p11(OUT r INT) LANGUAGE PYTHON AS $$ del r $$;
--error ER_UNKNOWN_ERROR
CALL p11(@r);

--echo #
--echo # Called from a routine in SQL, with local variables
--echo #

DELIMITER |;
CREATE PROCEDURE sql_p(OUT result VARCHAR(100))
BEGIN
  DECLARE n INT DEFAULT 1;
  DECLARE t VARCHAR(50);
  DECLARE d DOUBLE;
  CALL p2('xy', n, t, d);
  CALL p2('z', n, t, d);
  SET result = CONCAT(n, ' ', t, ' ', d);
END|
DELIMITER ;|
CALL sql_p(@result);
SELECT @result;
DROP PROCEDURE sql_p;

--echo # The definition in the catalog
--vertical_results
SHOW CREATE PROCEDURE p2;
--horizontal_results
SELECT ROUTINE_NAME, ROUTINE_TYPE, ROUTINE_BODY, EXTERNAL_LANGUAGE
  FROM INFORMATION_SCHEMA.ROUTINES
  WHERE ROUTINE_SCHEMA = 'test' AND ROUTINE_NAME = 'p2';

DROP PROCEDURE p1;
DROP PROCEDURE p2;
DROP PROCEDURE p3;
DROP PROCEDURE p4;
DROP PROCEDURE p5;
DROP PROCEDURE p6;
DROP PROCEDURE p7;
DROP PROCEDURE p8;
DROP PROCEDURE p9;
DROP PROCEDURE p10;
DROP PROCEDURE p11;
