--echo #
--echo # Python thread state kept for the duration of a statement
--echo # (Py_thread_pin): statement shapes that create and release it.
--echo #

CREATE TABLE t1 (id INT NOT NULL PRIMARY KEY, grp INT NOT NULL);
INSERT INTO t1 VALUES (1, 1), (2, 1), (3, 2), (4, 2), (5, 2);

SELECT py_create_function('twice', 'INT', 'x', 'result = x * 2');

--echo # --- several rows, several Python items in one statement ---
SELECT id, py_eval('args[0] + 1', 'INT', id) AS e,
       py_exec('result = args[0] * 10', 'INT', id) AS x,
       py_call('twice', id) AS c
FROM t1 ORDER BY id;

--echo # --- Python item in WHERE and in the select list ---
SELECT id, py_call('twice', id) AS c FROM t1
WHERE py_exec('result = args[0] % 2', 'INT', id) = 1 ORDER BY id;

--echo # --- subquery and derived table ---
SELECT id FROM t1
WHERE py_call('twice', id) IN (SELECT py_call('twice', id) FROM t1 WHERE grp = 2)
ORDER BY id;
SELECT SUM(c) FROM (SELECT py_call('twice', id) AS c FROM t1) d;

--echo # --- prepared statement executed several times ---
PREPARE st FROM "SELECT SUM(py_call('twice', id)) AS s FROM t1 WHERE id <= ?";
EXECUTE st USING 2;
EXECUTE st USING 5;
EXECUTE st USING 3;
DEALLOCATE PREPARE st;

--echo # --- a statement that fails in the middle of the scan, then a normal one ---
--error ER_UNKNOWN_ERROR
SELECT py_exec('result = 10 // (3 - args[0])', 'INT', id) FROM t1 ORDER BY id;
SELECT SUM(py_exec('result = args[0]', 'INT', id)) AS s FROM t1;
--error ER_UNKNOWN_ERROR
SELECT py_call('twice', id), py_eval('10 // (3 - args[0])', 'INT', id) FROM t1 ORDER BY id;
SELECT SUM(py_call('twice', id)) AS s FROM t1;

--echo # --- built-in aggregates over a Python item, per group ---
SELECT grp, SUM(py_call('twice', id)) AS a, py_call('twice', grp) AS c
FROM t1 GROUP BY grp ORDER BY grp;
SELECT id, SUM(py_call('twice', id)) OVER (PARTITION BY grp ORDER BY id) AS w
FROM t1 ORDER BY id;

--echo # --- stored procedure: the same statement in a loop ---
delimiter |;
CREATE PROCEDURE p1()
BEGIN
  DECLARE i INT DEFAULT 0;
  DECLARE s INT DEFAULT 0;
  DECLARE v INT;
  WHILE i < 3 DO
    SELECT SUM(py_call('twice', id)) INTO v FROM t1;
    SET s= s + v + py_eval('args[0]', 'INT', i);
    SET i= i + 1;
  END WHILE;
  SELECT s;
END|
delimiter ;|
CALL p1();
CALL p1();
DROP PROCEDURE p1;

--echo # --- nested: a Python body runs a statement that calls Python per row ---
SELECT py_exec('
import inhost
rows = inhost.sql.query("SELECT SUM(py_call(\'twice\', id)) FROM test.t1")
result = int(rows[0][0])
', 'INT') AS nested;
SELECT id, py_exec('
import inhost
rows = inhost.sql.query(
    "SELECT SUM(py_call(\'twice\', id)) FROM test.t1 WHERE id <= %s", (args[0],))
result = int(rows[0][0])
', 'INT', id) AS nested
FROM t1 ORDER BY id;

--echo # --- constant items, no table ---
SELECT py_call('twice', 21), py_eval('1 + 1', 'INT');
DO py_call('twice', 1);

--echo # --- cleanup ---
SELECT py_drop_function('twice');
DROP TABLE t1;
DROP TABLE mysql.lang_python_func;
