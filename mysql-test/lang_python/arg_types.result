#
# Argument type marshaling: verifies that SQL types are correctly
# mapped to Python types, matching C connector conventions.
#
# --- Signed vs unsigned integers ---
# Signed integers use PyLong_FromLongLong, unsigned use PyLong_FromUnsignedLongLong.
SELECT py_eval('type(args[0]).__name__', 'VARCHAR', 42);
py_eval('type(args[0]).__name__', 'VARCHAR', 42)
int
SELECT py_eval('type(args[0]).__name__', 'VARCHAR', -1);
py_eval('type(args[0]).__name__', 'VARCHAR', -1)
int
SELECT py_eval('type(args[0]).__name__', 'VARCHAR', CAST(42 AS UNSIGNED));
py_eval('type(args[0]).__name__', 'VARCHAR', CAST(42 AS UNSIGNED))
int
# BIGINT UNSIGNED max: 2^64-1 = 18446744073709551615
SELECT py_eval('args[0]', 'VARCHAR', CAST(18446744073709551615 AS UNSIGNED));
py_eval('args[0]', 'VARCHAR', CAST(18446744073709551615 AS UNSIGNED))
18446744073709551615
SELECT py_eval('args[0] > 2**63', 'INT', CAST(18446744073709551615 AS UNSIGNED));
py_eval('args[0] > 2**63', 'INT', CAST(18446744073709551615 AS UNSIGNED))
1
# Signed BIGINT boundary values
SELECT py_eval('args[0]', 'VARCHAR', CAST(9223372036854775807 AS SIGNED));
py_eval('args[0]', 'VARCHAR', CAST(9223372036854775807 AS SIGNED))
9223372036854775807
SELECT py_eval('args[0]', 'VARCHAR', CAST(-9223372036854775808 AS SIGNED));
py_eval('args[0]', 'VARCHAR', CAST(-9223372036854775808 AS SIGNED))
-9223372036854775808
# --- DECIMAL vs FLOAT distinction ---
# Bare decimal literals arrive as decimal.Decimal (lossless).
# Scientific notation or CAST(... AS DOUBLE) arrives as float.
SELECT py_eval('type(args[0]).__name__', 'VARCHAR', 2.5);
py_eval('type(args[0]).__name__', 'VARCHAR', 2.5)
Decimal
SELECT py_eval('type(args[0]).__name__', 'VARCHAR', 2.5e0);
py_eval('type(args[0]).__name__', 'VARCHAR', 2.5e0)
float
SELECT py_eval('type(args[0]).__name__', 'VARCHAR', CAST(2.5 AS DOUBLE));
py_eval('type(args[0]).__name__', 'VARCHAR', CAST(2.5 AS DOUBLE))
float
# Decimal arithmetic preserves precision
SELECT py_eval('str(args[0] + args[1])', 'VARCHAR', 0.1, 0.2);
py_eval('str(args[0] + args[1])', 'VARCHAR', 0.1, 0.2)
0.3
# Float arithmetic has floating-point imprecision
SELECT py_eval('str(args[0] + args[1])', 'VARCHAR', 0.1e0, 0.2e0);
py_eval('str(args[0] + args[1])', 'VARCHAR', 0.1e0, 0.2e0)
0.30000000000000004
# Decimal from DECIMAL column
CREATE TABLE t1 (d DECIMAL(10,2));
INSERT INTO t1 VALUES (3.14), (99.99);
SELECT d, py_eval('type(args[0]).__name__', 'VARCHAR', d) AS python_type FROM t1;
d	python_type
3.14	Decimal
99.99	Decimal
SELECT d, py_eval('str(args[0])', 'VARCHAR', d) AS python_value FROM t1;
d	python_value
3.14	3.14
99.99	99.99
DROP TABLE t1;
# --- String vs binary distinction ---
# String literals and VARCHAR columns arrive as Python str.
# Hex literals, VARBINARY, UNHEX(), binary charset data arrive as Python bytes.
SELECT py_eval('type(args[0]).__name__', 'VARCHAR', 'hello');
py_eval('type(args[0]).__name__', 'VARCHAR', 'hello')
str
SELECT py_eval('type(args[0]).__name__', 'VARCHAR', X'DEADBEEF');
py_eval('type(args[0]).__name__', 'VARCHAR', X'DEADBEEF')
bytes
SELECT py_eval('type(args[0]).__name__', 'VARCHAR', UNHEX('48454C4C4F'));
py_eval('type(args[0]).__name__', 'VARCHAR', UNHEX('48454C4C4F'))
bytes
SELECT py_eval('type(args[0]).__name__', 'VARCHAR', CAST('hello' AS BINARY));
py_eval('type(args[0]).__name__', 'VARCHAR', CAST('hello' AS BINARY))
bytes
# Binary data from VARBINARY column
CREATE TABLE t2 (v VARBINARY(100));
INSERT INTO t2 VALUES (X'010203'), (UNHEX('AABBCC'));
SELECT HEX(v), py_eval('type(args[0]).__name__', 'VARCHAR', v) AS python_type FROM t2;
HEX(v)	python_type
010203	bytes
AABBCC	bytes
SELECT HEX(v), py_eval('args[0].hex()', 'VARCHAR', v) AS hex_value FROM t2;
HEX(v)	hex_value
010203	010203
AABBCC	aabbcc
DROP TABLE t2;
# --- Integer from INT UNSIGNED column ---
CREATE TABLE t3 (u BIGINT UNSIGNED);
INSERT INTO t3 VALUES (0), (9223372036854775807), (18446744073709551615);
SELECT u, py_eval('type(args[0]).__name__', 'VARCHAR', u) AS python_type FROM t3;
u	python_type
0	int
9223372036854775807	int
18446744073709551615	int
SELECT u, py_eval('str(args[0])', 'VARCHAR', u) AS python_value FROM t3;
u	python_value
0	0
9223372036854775807	9223372036854775807
18446744073709551615	18446744073709551615
DROP TABLE t3;
# --- Mixed types in one call ---
SELECT py_eval('"|".join(type(a).__name__ for a in args)', 'VARCHAR',
42, 2.5, 2.5e0, 'text', X'FF');
py_eval('"|".join(type(a).__name__ for a in args)', 'VARCHAR',
42, 2.5, 2.5e0, 'text', X'FF')
int|Decimal|float|str|bytes
# --- VECTOR column argument arrives as numpy.ndarray(float32) ---
CREATE TABLE tv (v VECTOR(3));
INSERT INTO tv VALUES (VEC_FromText('[1,2,3]')), (VEC_FromText('[0.5,-1,4]'));
SELECT py_eval('type(args[0]).__name__ + ":" + str(args[0].dtype) + ":" + str(args[0].tolist())', 'VARCHAR', v) AS vec FROM tv;
vec
ndarray:float32:[1.0, 2.0, 3.0]
ndarray:float32:[0.5, -1.0, 4.0]
DROP TABLE tv;
