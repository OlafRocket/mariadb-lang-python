#
# lang_python: SQL values as Python objects and back, in routines of
# the language PYTHON
#
#
# Arguments. Each function describes what it receives
#
CREATE FUNCTION d_int(x INT) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_uint(x INT UNSIGNED) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_tiny(x TINYINT) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_bool(x BOOLEAN) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_big(x BIGINT) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_ubig(x BIGINT UNSIGNED) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_double(x DOUBLE) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_float(x FLOAT) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_dec(x DECIMAL(30,5)) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_year(x YEAR) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_bit(x BIT(8)) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_date(x DATE) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_time(x TIME(2)) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_datetime(x DATETIME(3)) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_text(x VARCHAR(50) CHARACTER SET utf8mb4) RETURNS VARCHAR(100) CHARACTER SET utf8mb4 LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + str(len(x)) + ' ' + x $$;
CREATE FUNCTION d_latin1(x VARCHAR(50) CHARACTER SET latin1) RETURNS VARCHAR(100) CHARACTER SET utf8mb4 LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + str(len(x)) + ' ' + x $$;
CREATE FUNCTION d_longtext(x LONGTEXT) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + str(len(x)) $$;
CREATE FUNCTION d_bin(x VARBINARY(50)) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + str(list(x)) $$;
CREATE FUNCTION d_blob(x BLOB) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + str(list(x)) $$;
CREATE FUNCTION d_vector(x VECTOR(3)) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + (str(x.dtype) + ' ' + str(x.tolist()) if hasattr(x, 'dtype') else str(len(x))) $$;
CREATE FUNCTION d_json(x JSON) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + x $$;
CREATE FUNCTION d_uuid(x UUID) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_inet6(x INET6) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
CREATE FUNCTION d_enum(x ENUM('small', 'large')) RETURNS VARCHAR(100) LANGUAGE PYTHON AS
$$ return type(x).__name__ + ' ' + repr(x) $$;
SELECT d_int(42), d_int(-2147483648), d_int(NULL);
d_int(42)	d_int(-2147483648)	d_int(NULL)
int 42	int -2147483648	NoneType None
SELECT d_uint(4294967295), d_tiny(-128), d_bool(TRUE), d_bool(FALSE);
d_uint(4294967295)	d_tiny(-128)	d_bool(TRUE)	d_bool(FALSE)
int 4294967295	int -128	int 1	int 0
SELECT d_big(9223372036854775807), d_big(-9223372036854775808);
d_big(9223372036854775807)	d_big(-9223372036854775808)
int 9223372036854775807	int -9223372036854775808
SELECT d_ubig(18446744073709551615);
d_ubig(18446744073709551615)
int 18446744073709551615
SELECT d_double(1.5), d_double(-1e300), d_double(3), d_float(0.25);
d_double(1.5)	d_double(-1e300)	d_double(3)	d_float(0.25)
float 1.5	float -1e+300	float 3.0	float 0.25
SELECT d_dec(12345678901234567890.12345), d_dec(-0.5);
d_dec(12345678901234567890.12345)	d_dec(-0.5)
Decimal Decimal('12345678901234567890.12345')	Decimal Decimal('-0.50000')
SELECT d_year(2026), d_bit(b'101');
d_year(2026)	d_bit(b'101')
int 2026	int 5
SELECT d_date('2026-02-28'), d_time('12:34:56.78'), d_datetime('2026-02-28 23:59:59.123');
d_date('2026-02-28')	d_time('12:34:56.78')	d_datetime('2026-02-28 23:59:59.123')
str '2026-02-28'	str '12:34:56.78'	str '2026-02-28 23:59:59.123'
SET NAMES utf8mb4;
SELECT d_text('grüße €'), d_text(''), d_text('𝄞');
d_text('grüße €')	d_text('')	d_text('?')
str 7 grüße €	str 0 	str 1 𝄞
SELECT d_latin1(CONVERT('grüße' USING latin1));
d_latin1(CONVERT('grüße' USING latin1))
str 5 grüße
SET NAMES latin1;
SELECT d_longtext(REPEAT('x', 100000));
d_longtext(REPEAT('x', 100000))
str 100000
SELECT d_bin(x'00FF10'), d_bin(''), d_blob(x'0102');
d_bin(x'00FF10')	d_bin('')	d_blob(x'0102')
bytes [0, 255, 16]	bytes []	bytes [1, 2]
SELECT d_vector(VEC_FromText('[1,2.5,-3]'));
d_vector(VEC_FromText('[1,2.5,-3]'))
ndarray float32 [1.0, 2.5, -3.0]
SELECT d_json('{"a": 1, "b": [true, null]}');
d_json('{"a": 1, "b": [true, null]}')
str {"a": 1, "b": [true, null]}
SELECT d_uuid('123e4567-e89b-12d3-a456-426655440000'), d_inet6('::ffff:192.0.2.1');
d_uuid('123e4567-e89b-12d3-a456-426655440000')	d_inet6('::ffff:192.0.2.1')
str '123e4567-e89b-12d3-a456-426655440000'	str '::ffff:192.0.2.1'
SELECT d_enum('large');
d_enum('large')
str 'large'
# VECTOR as bytes
SET @save_vector_numpy = @@global.lang_python_vector_numpy;
SET GLOBAL lang_python_vector_numpy = OFF;
SELECT d_vector(VEC_FromText('[1,2.5,-3]'));
d_vector(VEC_FromText('[1,2.5,-3]'))
bytes 12
SET GLOBAL lang_python_vector_numpy = @save_vector_numpy;
#
# Results. The server converts the value to the declared type
#
CREATE FUNCTION r_int(what VARCHAR(20)) RETURNS INT LANGUAGE PYTHON AS $$
    import decimal
    values = {'int': 42, 'float': 41.5, 'string': '43', 'true': True,
              'false': False, 'decimal': decimal.Decimal('44.4'),
              'none': None, 'text': 'abc', 'large': 2 ** 40}
    return values[what]
$$;
SELECT r_int('int'), r_int('float'), r_int('string'), r_int('true'),
r_int('false'), r_int('decimal'), r_int('none');
r_int('int')	r_int('float')	r_int('string')	r_int('true')	r_int('false')	r_int('decimal')	r_int('none')
42	42	43	1	0	44	NULL
# In strict mode a value that does not fit is an error
SELECT r_int('text');
ERROR 22007: Incorrect integer value: 'abc' for column ``.``.`r_int('text')` at row 0
SELECT r_int('large');
ERROR 22003: Out of range value for column 'r_int('large')' at row 0
# The sql_mode of the definition counts, as for a routine in SQL
SET @save_sql_mode = @@sql_mode;
SET sql_mode = '';
SELECT r_int('text');
ERROR 22007: Incorrect integer value: 'abc' for column ``.``.`r_int('text')` at row 0
CREATE FUNCTION r_int_lax(what VARCHAR(20)) RETURNS INT LANGUAGE PYTHON AS
$$ return '12abc' if what == 'text' else 2 ** 40 $$;
SET sql_mode = @save_sql_mode;
SELECT r_int_lax('text'), r_int_lax('large');
r_int_lax('text')	r_int_lax('large')
12	2147483647
Warnings:
Warning	1265	Data truncated for column 'r_int_lax('text')' at row 0
CREATE FUNCTION r_ubig(n INT) RETURNS BIGINT UNSIGNED LANGUAGE PYTHON AS
$$ return 2 ** 64 - n $$;
SELECT r_ubig(1), r_ubig(2);
r_ubig(1)	r_ubig(2)
18446744073709551615	18446744073709551614
SELECT r_ubig(0);
ERROR 22003: Out of range value for column 'r_ubig(0)' at row 0
CREATE FUNCTION r_big(n BIGINT) RETURNS BIGINT LANGUAGE PYTHON AS
$$ return n - 1 $$;
SELECT r_big(-9223372036854775807), r_big(9223372036854775807), r_big(10);
r_big(-9223372036854775807)	r_big(9223372036854775807)	r_big(10)
-9223372036854775808	9223372036854775806	9
CREATE FUNCTION r_double(x DOUBLE) RETURNS DOUBLE LANGUAGE PYTHON AS $$
    import math
    return math.sqrt(x)
$$;
SELECT r_double(2), r_double(16);
r_double(2)	r_double(16)
1.4142135623730951	4
# DECIMAL keeps its digits in both directions
CREATE FUNCTION r_dec(x DECIMAL(30,5)) RETURNS DECIMAL(30,5) LANGUAGE PYTHON AS
$$ return x + 1 $$;
SELECT r_dec(12345678901234567890.12345);
r_dec(12345678901234567890.12345)
12345678901234567891.12345
# An int beyond 64 bits is stored as its digits
CREATE FUNCTION r_dec2() RETURNS DECIMAL(40,0) LANGUAGE PYTHON AS
$$ return 2 ** 100 $$;
SELECT r_dec2();
r_dec2()
1267650600228229401496703205376
# The body is in the character set of the client that creates the
# function
SET NAMES utf8mb4;
CREATE FUNCTION r_text(what VARCHAR(20)) RETURNS VARCHAR(100) CHARACTER SET utf8mb4 LANGUAGE PYTHON AS $$
    import datetime, decimal, fractions
    values = {'int': 42, 'float': 1.5, 'big': 2 ** 70, 'true': True,
              'unicode': 'grüße € 𝄞', 'empty': '',
              'bytes': b'abc', 'decimal': decimal.Decimal('1.50'),
              'date': datetime.date(2026, 2, 28),
              'object': fractions.Fraction(3, 4)}
    return values[what]
$$;
SELECT r_text('int'), r_text('float'), r_text('big'), r_text('true');
r_text('int')	r_text('float')	r_text('big')	r_text('true')
42	1.5	1180591620717411303424	1
SELECT r_text('unicode'), r_text('empty'), r_text('bytes'), r_text('decimal');
r_text('unicode')	r_text('empty')	r_text('bytes')	r_text('decimal')
grüße € 𝄞		abc	1.50
SELECT r_text('date'), r_text('object');
r_text('date')	r_text('object')
2026-02-28	3/4
CREATE FUNCTION r_latin1() RETURNS VARCHAR(100) CHARACTER SET latin1 LANGUAGE PYTHON AS
$$ return 'grüße' $$;
SELECT r_latin1(), HEX(r_latin1());
r_latin1()	HEX(r_latin1())
grüße	6772FCDF65
SET NAMES latin1;
# Temporal types take the text form and the classes of datetime
CREATE FUNCTION r_date(what INT) RETURNS DATE LANGUAGE PYTHON AS $$
    import datetime
    return '2026-02-28' if what == 0 else datetime.date(2027, 1, 31)
$$;
CREATE FUNCTION r_datetime() RETURNS DATETIME(3) LANGUAGE PYTHON AS $$
    import datetime
    return datetime.datetime(2026, 2, 28, 23, 59, 59, 123000)
$$;
SELECT r_date(0), r_date(1), r_datetime();
r_date(0)	r_date(1)	r_datetime()
2026-02-28	2027-01-31	2026-02-28 23:59:59.123
# Binary results
CREATE FUNCTION r_bin(what INT) RETURNS VARBINARY(20) LANGUAGE PYTHON AS $$
    if what == 0:
        return b'\x00\xff\x10'
    if what == 1:
        return bytearray([1, 2, 3])
    return memoryview(b'xyz')
$$;
SELECT HEX(r_bin(0)), HEX(r_bin(1)), HEX(r_bin(2));
HEX(r_bin(0))	HEX(r_bin(1))	HEX(r_bin(2))
00FF10	010203	78797A
# VECTOR: a float32 array, or its bytes
CREATE FUNCTION r_vector(v VECTOR(3)) RETURNS VECTOR(3) LANGUAGE PYTHON AS
$$ return v * 2 $$;
CREATE FUNCTION r_vector2() RETURNS VECTOR(2) LANGUAGE PYTHON AS $$
    import struct
    return struct.pack('<2f', 0.5, -1.0)
$$;
SELECT VEC_ToText(r_vector(VEC_FromText('[1,2.5,-3]'))), VEC_ToText(r_vector2());
VEC_ToText(r_vector(VEC_FromText('[1,2.5,-3]')))	VEC_ToText(r_vector2())
[2,5,-6]	[0.5,-1]
# A JSON return type is text for the plugin: the body returns text
CREATE FUNCTION r_json(x JSON) RETURNS JSON LANGUAGE PYTHON AS $$
    import json
    value = json.loads(x)
    value['added'] = True
    return json.dumps(value)
$$;
SELECT r_json('{"a": 1}');
r_json('{"a": 1}')
{"a": 1, "added": true}
#
# Values without an SQL value
#
CREATE FUNCTION r_none(what VARCHAR(20)) RETURNS VARCHAR(100) LANGUAGE PYTHON AS $$
    values = {'nan': float('nan'), 'inf': float('-inf'), 'list': [1, 2],
              'dict': {'a': 1}, 'tuple': (1, 2), 'set': {1},
              'function': len, 'lambda': lambda: 1, 'class': int,
              'generator': (i for i in range(3))}
    return values[what]
$$;
SELECT r_none('nan');
ERROR HY000: Python: test.r_none: the value is NaN, which has no SQL value
SELECT r_none('inf');
ERROR HY000: Python: test.r_none: the value is an infinity, which has no SQL value
SELECT r_none('list');
ERROR HY000: Python: test.r_none: a value of type 'list' has no SQL value
SELECT r_none('dict');
ERROR HY000: Python: test.r_none: a value of type 'dict' has no SQL value
SELECT r_none('tuple');
ERROR HY000: Python: test.r_none: a value of type 'tuple' has no SQL value
SELECT r_none('set');
ERROR HY000: Python: test.r_none: a value of type 'set' has no SQL value
SELECT r_none('function');
ERROR HY000: Python: test.r_none: a value of type 'builtin_function_or_method' has no SQL value
SELECT r_none('lambda');
ERROR HY000: Python: test.r_none: a value of type 'function' has no SQL value
SELECT r_none('class');
ERROR HY000: Python: test.r_none: a value of type 'type' has no SQL value
SELECT r_none('generator');
ERROR HY000: Python: test.r_none: a value of type 'generator' has no SQL value
# A ROW parameter is refused at CREATE
CREATE FUNCTION e1(r ROW(a INT, b INT)) RETURNS INT LANGUAGE PYTHON AS $$ return 1 $$;
ERROR 42000: This version of MariaDB doesn't yet support 'A parameter of this type in Python'
