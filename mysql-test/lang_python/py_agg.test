--source include/have_sequence.inc

--echo #
--echo # py_agg (Phase 2): aggregate that calls a named Python function once
--echo # per group with one numpy array per argument
--echo #

CREATE TABLE t1 (
  grp INT, id INT, d DOUBLE, dec1 DECIMAL(10,2), name VARCHAR(20),
  data BLOB, ub BIGINT UNSIGNED, v VECTOR(2)
);
INSERT INTO t1 VALUES
  (1, 1, 1.5,  10.25, 'alice', x'00FF', 1, VEC_FromText('[1,2]')),
  (1, 2, 2.5,  20.50, 'bob',   x'AB',   2, VEC_FromText('[3,4]')),
  (2, 3, 4.0,  30.00, 'carol', x'01',   3, VEC_FromText('[5,6]')),
  (2, 4, NULL, NULL,  NULL,    NULL,    4, VEC_FromText('[7,8]')),
  (2, 5, 6.0,  40.00, 'carol', x'02',   5, VEC_FromText('[9,10]'));

--echo # --- named parameters: one call per group, arrays cover the group ---
SELECT py_create_function('describe', 'VARCHAR', 'ids,vals', '
result = type(ids).__name__ + ":" + str(ids.dtype) + str(ids.tolist()) + " " + str(vals.dtype) + str(vals.tolist())
');
SELECT grp, py_agg('describe', id, d) AS a FROM t1 GROUP BY grp ORDER BY grp;
SELECT py_agg('describe', id, d) AS whole_table FROM t1;

--echo # --- args[] mode: a tuple of arrays ---
SELECT py_create_function('describe_args', 'VARCHAR', NULL, '
result = str(len(args)) + " " + ";".join(str(a.dtype) + str(a.shape) for a in args)
');
SELECT grp, py_agg('describe_args', id, d, name, v) AS a FROM t1 GROUP BY grp ORDER BY grp;

--echo # --- type mapping of the arguments ---
SELECT py_create_function('types', 'VARCHAR', NULL, '
result = "\\n".join(str(a.dtype) + " " + str(a.shape) + " " + ascii(a.tolist()) for a in args)
');
SELECT py_agg('types', id, ub, d, dec1, name, data, v) AS a FROM t1 WHERE grp = 1;
SELECT py_agg('types', d, dec1, name, data) AS nulls FROM t1 WHERE grp = 2;

--echo # --- return types follow the function declaration ---
SELECT py_create_function('r_int', 'INT', 'x', 'result = int(x.sum())');
SELECT py_create_function('r_double', 'DOUBLE', 'x', 'import numpy
result = float(numpy.nanmean(x))');
SELECT py_create_function('r_decimal', 'DECIMAL', 'x', 'import numpy
result = str(round(float(numpy.nansum(x)), 2))');
SELECT py_create_function('r_bool', 'BOOL', 'x', 'result = bool((x > 3).any())');
SELECT py_create_function('r_blob', 'BLOB', 'x', 'result = x.astype("uint8").tobytes()');
SELECT grp, py_agg('r_int', id) AS i, py_agg('r_double', d) AS dbl,
       py_agg('r_decimal', dec1) AS dcm, py_agg('r_bool', id) AS b,
       HEX(py_agg('r_blob', id)) AS blb
FROM t1 GROUP BY grp ORDER BY grp;
CREATE TABLE t2 AS
  SELECT grp, py_agg('r_int', id) AS i, py_agg('r_double', d) AS dbl,
         py_agg('r_decimal', dec1) AS dcm, py_agg('describe', id, d) AS s
  FROM t1 GROUP BY grp;
SHOW CREATE TABLE t2;
SELECT * FROM t2 ORDER BY grp;
DROP TABLE t2;

--echo # --- several aggregates, expressions as arguments, HAVING, ORDER BY ---
SELECT grp, py_agg('r_int', id * 10) AS s10, py_agg('r_int', id) + COUNT(*) AS mixed
FROM t1 GROUP BY grp HAVING py_agg('r_int', id) > 3 ORDER BY py_agg('r_int', id) DESC;

--echo # --- empty input: SQL NULL, Python is not called ---
SELECT py_agg('r_int', id) AS no_rows FROM t1 WHERE id < 0;
SELECT grp, py_agg('r_int', id) AS no_groups FROM t1 WHERE id < 0 GROUP BY grp;

--echo # --- result None gives NULL ---
SELECT py_create_function('r_none', 'INT', 'x', 'result = None');
SELECT py_agg('r_none', id) AS n FROM t1;

--echo # --- DISTINCT and FILTER are applied by the server ---
SELECT py_create_function('sorted_list', 'VARCHAR', 'x', 'result = str(sorted(x.tolist()))');
SELECT py_agg('sorted_list', grp) AS all_rows, py_agg(DISTINCT 'sorted_list', grp) AS uniq FROM t1;
SELECT grp, py_agg(DISTINCT 'sorted_list', name) AS uniq_names FROM t1 WHERE name IS NOT NULL GROUP BY grp ORDER BY grp;
SELECT py_agg('sorted_list', id) FILTER (WHERE id > 2) AS filtered,
       py_agg('sorted_list', id) AS unfiltered FROM t1;

--echo # --- window function: every frame is recomputed ---
SELECT id, py_agg('sorted_list', id) OVER (PARTITION BY grp ORDER BY id) AS running,
           py_agg('sorted_list', id) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS sliding
FROM t1 ORDER BY id;

--echo # --- VECTOR argument: 2-D float32 batch ---
SELECT py_create_function('vec_mean', 'VARCHAR', 'm', 'result = str(m.shape) + " " + str(m.mean(axis=0).tolist())');
SELECT grp, py_agg('vec_mean', v) AS a FROM t1 GROUP BY grp ORDER BY grp;

--echo # --- larger groups: 300000 rows in 3 groups ---
SELECT seq MOD 3 AS g, py_agg('r_int', seq) AS s, SUM(seq) AS expected
FROM seq_1_to_300000 GROUP BY seq MOD 3 ORDER BY g;

--echo # --- prepared statement: executed twice, catalog change in between ---
PREPARE st FROM "SELECT grp, py_agg('r_int', id) AS s FROM t1 GROUP BY grp ORDER BY grp";
EXECUTE st;
SELECT py_replace_function('r_int', 'INT', 'x', 'result = int(x.sum()) * 1000');
EXECUTE st;
SELECT py_replace_function('r_int', 'INT', 'x', 'result = int(x.sum())');
EXECUTE st;
DEALLOCATE PREPARE st;

--echo # --- errors at prepare time ---
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT py_agg('r_int') FROM t1;
--error ER_UNKNOWN_ERROR
SELECT py_agg('no_such_function', id) FROM t1;
--error ER_UNKNOWN_ERROR
SELECT py_agg(name, id) FROM t1;
--error ER_UNKNOWN_ERROR
SELECT py_agg(NULL, id) FROM t1;
--error ER_UNKNOWN_ERROR
SELECT py_agg('r_int', id, d) FROM t1;
--error ER_INVALID_GROUP_FUNC_USE
SELECT py_agg('r_int', SUM(id)) FROM t1;

--echo # --- errors at run time ---
--echo # NULL in an integer argument
CREATE TABLE t3 (i INT, v VECTOR(2));
INSERT INTO t3 VALUES (1, VEC_FromText('[1,2]')), (NULL, NULL);
--error ER_UNKNOWN_ERROR
SELECT py_agg('r_int', i) FROM t3;
SELECT py_agg('r_int', i) FILTER (WHERE i IS NOT NULL) AS filtered FROM t3;
--echo # NULL in a VECTOR argument
--error ER_UNKNOWN_ERROR
SELECT py_agg('vec_mean', v) FROM t3;
DROP TABLE t3;
--echo # Python exception: strict function aborts, lax function gives NULL + warning
SELECT py_create_function('boom_strict', 'INT', 'x', 'result = 1 // 0');
SELECT py_create_function('boom_lax', 'INT', 'x', 'result = 1 // 0', 0);
--error ER_UNKNOWN_ERROR
SELECT py_agg('boom_strict', id) FROM t1;
SELECT py_agg('boom_lax', id) AS lax FROM t1;

--echo # --- lang_python_agg_max_mem bounds one group ---
SELECT @@lang_python_agg_max_mem;
SET SESSION lang_python_agg_max_mem = 4096;
SELECT py_agg('r_int', seq) AS fits FROM seq_1_to_500;
--error ER_UNKNOWN_ERROR
SELECT py_agg('r_int', seq) FROM seq_1_to_5000;
SELECT seq MOD 100 AS g, py_agg('r_int', seq) AS small_groups_fit
FROM seq_1_to_5000 GROUP BY seq MOD 100 ORDER BY g LIMIT 2;
--echo # a window frame is bounded as well
--error ER_UNKNOWN_ERROR
SELECT py_agg('r_int', seq) OVER () FROM seq_1_to_5000;
SET SESSION lang_python_agg_max_mem = DEFAULT;

--echo # --- the function is called once per group ---
SELECT py_create_function('counted', 'INT', 'x', '
import sys
sys.modules.setdefault("__main__").__dict__["py_agg_calls"] = sys.modules["__main__"].__dict__.get("py_agg_calls", 0) + 1
result = len(x)
');
SELECT grp, py_agg('counted', id) AS n FROM t1 GROUP BY grp ORDER BY grp;
SELECT py_eval('__import__("sys").modules["__main__"].__dict__.pop("py_agg_calls")', 'INT') AS calls;

SELECT py_drop_function('describe');
SELECT py_drop_function('describe_args');
SELECT py_drop_function('types');
SELECT py_drop_function('r_int');
SELECT py_drop_function('r_double');
SELECT py_drop_function('r_decimal');
SELECT py_drop_function('r_bool');
SELECT py_drop_function('r_blob');
SELECT py_drop_function('r_none');
SELECT py_drop_function('sorted_list');
SELECT py_drop_function('vec_mean');
SELECT py_drop_function('boom_strict');
SELECT py_drop_function('boom_lax');
SELECT py_drop_function('counted');
DROP TABLE t1;

# The catalog table is auto-created on first use; drop it again so MTR's
# check-testcase sees identical before/after states of the mysql schema.
DROP TABLE mysql.lang_python_func;
