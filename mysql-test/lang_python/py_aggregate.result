#
# Python aggregates (Phase 2): catalog kind 'aggregate', a class with
# step()/finalize() that py_agg feeds one chunk of rows at a time
#
CREATE TABLE t1 (grp INT, id INT, d DOUBLE, name VARCHAR(20), v VECTOR(2));
INSERT INTO t1 VALUES
(1, 1, 1.5,  'alice', VEC_FromText('[1,2]')),
(1, 2, 2.5,  'bob',   VEC_FromText('[3,4]')),
(2, 3, 4.0,  'carol', VEC_FromText('[5,6]')),
(2, 4, NULL, NULL,    VEC_FromText('[7,8]')),
(2, 5, 6.0,  'carol', VEC_FromText('[9,10]'));
# --- create; the catalog records the kind ---
SELECT py_create_aggregate('a_sum', 'INT', 'x', '
class Aggregate:
    def __init__(self):
        self.total = 0
    def step(self, x):
        self.total += int(x.sum())
    def finalize(self):
        return self.total
');
py_create_aggregate('a_sum', 'INT', 'x', '
class Aggregate:
    def __init__(self):
        self.total = 0
    def step(self, x):
        self.total += int(x.sum())
    def finalize(self):
        return self.total
')
1
SELECT py_create_function('f_sum', 'INT', 'x', 'result = int(x.sum())');
py_create_function('f_sum', 'INT', 'x', 'result = int(x.sum())')
1
SELECT name, kind, return_type, param_names FROM mysql.lang_python_func ORDER BY name;
name	kind	return_type	param_names
a_sum	aggregate	INT	x
f_sum	function	INT	x
# --- one instance per group ---
SELECT grp, py_agg('a_sum', id) AS s FROM t1 GROUP BY grp ORDER BY grp;
grp	s
1	3
2	12
SELECT py_agg('a_sum', id) AS whole_table FROM t1;
whole_table
15
# --- step() sees arrays of at most lang_python_agg_chunk_rows rows ---
SELECT @@lang_python_agg_chunk_rows;
@@lang_python_agg_chunk_rows
65536
SELECT py_create_aggregate('a_trace', 'VARCHAR', 'x,y', '
class Aggregate:
    def __init__(self):
        self.calls = []
    def step(self, x, y):
        self.calls.append(type(x).__name__ + ":" + str(x.dtype) + str(x.tolist()) + "/" + str(y.dtype) + str(y.tolist()))
    def finalize(self):
        return " | ".join(self.calls)
');
