# --- prepared statement across py_replace_aggregate ---
PREPARE st FROM "SELECT grp, py_agg('a_sum', id) AS s FROM t1 GROUP BY grp ORDER BY grp";
EXECUTE st;
grp	s
1	3
2	12
SELECT py_replace_aggregate('a_sum', 'INT', 'x', '
class Aggregate:
    def __init__(self):
        self.total = 0
    def step(self, x):
        self.total += int(x.sum()) * 100
    def finalize(self):
        return self.total
');
py_replace_aggregate('a_sum', 'INT', 'x', '
class Aggregate:
    def __init__(self):
        self.total = 0
    def step(self, x):
        self.total += int(x.sum()) * 100
    def finalize(self):
        return self.total
')
1
EXECUTE st;
grp	s
1	300
2	1200
DEALLOCATE PREPARE st;
# --- kinds share one namespace ---
