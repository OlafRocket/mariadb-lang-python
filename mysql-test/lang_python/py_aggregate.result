SELECT py_create_aggregate('a_boom', 'INT', 'x,where', '
class Aggregate:
    def __init__(self):
        self.n = 0
        self.where = None
    def step(self, x, where):
        self.where = where[0]
        if self.where == "init":
            raise RuntimeError("never reached")
        if self.where == "step":
            raise RuntimeError("in step")
        self.n += len(x)
    def finalize(self):
        if self.where == "finalize":
            raise RuntimeError("in finalize")
        return self.n
');
