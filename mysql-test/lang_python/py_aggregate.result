CREATE TABLE t2 AS SELECT grp, py_agg('a_mean', d) AS m, py_agg('a_trace', id, d) AS t FROM t1 GROUP BY grp;
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `grp` int(11) DEFAULT NULL,
  `m` double DEFAULT NULL,
  `t` longtext CHARACTER SET utf8mb3 COLLATE utf8mb3_general1400_as_ci DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
