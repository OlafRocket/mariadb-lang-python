# --- return types, NULL results, empty input ---
SELECT py_create_aggregate('a_mean', 'DOUBLE', 'x', '
import numpy
class Aggregate:
    def __init__(self):
        self.n = 0
        self.total = 0.0
    def step(self, x):
        ok = x[~numpy.isnan(x)]
        self.n += len(ok)
        self.total += float(ok.sum())
    def finalize(self):
        return self.total / self.n if self.n else None
');
