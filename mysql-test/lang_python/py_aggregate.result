# --- an aggregate survives a restart as an aggregate ---
SELECT py_create_aggregate('new_agg', 'INT', 'x', '
class Aggregate:
    def __init__(self):
        self.n = 0
    def step(self, x):
        self.n += len(x)
    def finalize(self):
        return self.n
');
