# --- the result does not depend on the chunk size ---
SELECT py_create_aggregate('a_stats', 'VARCHAR', 'x', '
import numpy
class Aggregate:
    def __init__(self):
        self.n = 0
        self.total = 0.0
        self.lo = None
        self.hi = None
        self.steps = 0
    def step(self, x):
        self.steps += 1
        self.n += len(x)
        self.total += float(x.sum())
        self.lo = float(x.min()) if self.lo is None else min(self.lo, float(x.min()))
        self.hi = float(x.max()) if self.hi is None else max(self.hi, float(x.max()))
    def finalize(self):
        return "n=%d sum=%.1f min=%.1f max=%.1f" % (self.n, self.total, self.lo, self.hi)
');
