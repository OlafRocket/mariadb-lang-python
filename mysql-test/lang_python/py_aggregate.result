# --- DISTINCT, FILTER, HAVING, several aggregates per statement ---
SELECT py_agg('a_sum', grp) AS all_rows, py_agg(DISTINCT 'a_sum', grp) AS uniq,
py_agg('a_sum', id) FILTER (WHERE id > 2) AS filtered,
py_agg('f_sum', id) AS whole_group_function
FROM t1;
all_rows	uniq	filtered	whole_group_function
8	3	12	15
SELECT grp, py_agg('a_sum', id) AS s FROM t1 GROUP BY grp HAVING py_agg('a_sum', id) > 3;
grp	s
2	12
# --- window frames: recomputed per row; running frames call finalize() repeatedly ---
SET SESSION lang_python_agg_chunk_rows = 2;
SELECT id, py_agg('a_sum', id) OVER (ORDER BY id) AS running,
py_agg('a_sum', id) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS sliding,
py_agg('a_sum', id) OVER (PARTITION BY grp) AS per_partition
FROM t1 ORDER BY id;
id	running	sliding	per_partition
1	1	3	3
2	3	6	3
3	6	9	12
4	10	12	12
5	15	9	12
SET SESSION lang_python_agg_chunk_rows = DEFAULT;
# --- the body runs once per statement, the class is instantiated per group ---
SELECT py_create_aggregate('a_count_inits', 'VARCHAR', 'x', '
body_runs = globals().get("body_runs", 0) + 1
instances = [0]
class Aggregate:
    def __init__(self):
        instances[0] += 1
        self.id = instances[0]
    def step(self, x):
        pass
    def finalize(self):
        return "body_runs=%d instance=%d" % (body_runs, self.id)
');
py_create_aggregate('a_count_inits', 'VARCHAR', 'x', '
body_runs = globals().get("body_runs", 0) + 1
instances = [0]
class Aggregate:
    def __init__(self):
        instances[0] += 1
        self.id = instances[0]
    def step(self, x):
        pass
    
