--echo #
--echo # py_eval: basic functionality
--echo #

--echo # --- INT return type ---
SELECT py_eval('2 ** 32', 'INT');
SELECT py_eval('2 ** 32', 'INTEGER');
SELECT py_eval('-1', 'INT');
SELECT py_eval('0', 'INT');

--echo # --- DOUBLE return type ---
SELECT py_eval('3.14159', 'DOUBLE');
SELECT py_eval('3.14159', 'FLOAT');
SELECT py_eval('1.0 / 3.0', 'DOUBLE');
# Server >= 12.3 renders DOUBLE negative zero as 0 (12.2 printed -0)
SELECT py_eval('-0.0', 'DOUBLE');

--echo # --- VARCHAR return type ---
SELECT py_eval('"hello world"', 'VARCHAR');
SELECT py_eval('"hello world"', 'TEXT');
SELECT py_eval('"hello world"', 'STRING');
SELECT py_eval('""', 'VARCHAR');

--echo # --- BLOB return type ---
SELECT py_eval('bytes([0, 1, 2])', 'BLOB');
SELECT py_eval('b""', 'BLOB');

--echo # --- Cross-type implicit conversion ---
--echo # int result requested as DOUBLE
SELECT py_eval('42', 'DOUBLE');
--echo # float result requested as INT (truncation)
SELECT py_eval('3.14', 'INT');
--echo # int result requested as VARCHAR
SELECT py_eval('42', 'VARCHAR');
--echo # float result requested as VARCHAR
SELECT py_eval('3.14', 'VARCHAR');

--echo # --- Variadic args ---
SELECT py_eval('args[0] + args[1]', 'INT', 10, 20);
SELECT py_eval('args[0] * args[1]', 'DOUBLE', 2.5, 4.0);
SELECT py_eval('args[0].upper()', 'VARCHAR', 'hello');
SELECT py_eval('len(args)', 'INT', 1, 2, 3, 4, 5);

--echo # --- Mixed arg types ---
SELECT py_eval('str(args[0]) + " " + args[1]', 'VARCHAR', 42, 'apples');

--echo # --- Python builtins ---
SELECT py_eval('len("hello")', 'INT');
SELECT py_eval('sorted([3,1,2]).__repr__()', 'VARCHAR');
SELECT py_eval('sum(range(101))', 'INT');

--echo # --- Python imports ---
SELECT py_eval('__import__("math").sqrt(2)', 'DOUBLE');
SELECT py_eval('__import__("json").dumps({"a": 1})', 'VARCHAR');

--echo # --- Large values ---
SELECT py_eval('2 ** 63 - 1', 'INT');
SELECT py_eval('"x" * 1000', 'VARCHAR') = REPEAT('x', 1000);

--echo # --- With table data ---
CREATE TABLE t1 (a INT, b DOUBLE);
INSERT INTO t1 VALUES (3, 4.0), (5, 12.0), (8, 15.0);

SELECT a, b, py_eval('__import__("math").sqrt(args[0]**2 + args[1]**2)', 'DOUBLE', a, b) AS hypotenuse FROM t1;

SELECT py_eval('args[0] + args[1]', 'INT', a, CAST(b AS INT)) FROM t1;

DROP TABLE t1;

--echo # --- In WHERE clause ---
CREATE TABLE t2 (word VARCHAR(50));
INSERT INTO t2 VALUES ('Hello'), ('World'), ('foo'), ('BAR');

SELECT word FROM t2 WHERE py_eval('len(args[0])', 'INT', word) <= 3;
SELECT word FROM t2 WHERE py_eval('args[0] == args[0].upper()', 'INT', word) = 1;

DROP TABLE t2;

--echo # --- DECIMAL return type ---
SELECT py_eval('__import__("decimal").Decimal("3.14159265358979323846")', 'DECIMAL');
SELECT py_eval('args[0] + args[1]', 'DECIMAL', 0.1, 0.2);
--echo # Python float returned as DECIMAL preserves the str() representation
SELECT py_eval('0.1 + 0.2', 'DECIMAL');

--echo # --- BOOL return type ---
SELECT py_eval('True', 'BOOL');
SELECT py_eval('False', 'BOOL');
SELECT py_eval('args[0] > 10', 'BOOL', 42);
SELECT py_eval('args[0] > 10', 'BOOL', 5);
SELECT py_eval('len(args[0]) > 3', 'BOOLEAN', 'hello');
